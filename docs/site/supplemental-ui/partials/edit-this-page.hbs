{{!-- the page's source on GitHub, for the version in progress, and the page as Markdown (extensions/llms.js) --}}
{{#if (or page.attributes.markdown (and page.editUrl (or env.FORCE_SHOW_EDIT_PAGE_LINK (not page.origin.private))))}}
<div class="edit-this-page">
{{#if (and page.editUrl (or env.FORCE_SHOW_EDIT_PAGE_LINK (not page.origin.private)))}}
<a href="{{page.editUrl}}">Edit this page</a>
{{/if}}
{{#with page.attributes.markdown}}
<a class="page-markdown" href="{{this}}" type="text/markdown">View as Markdown</a>
{{/with}}
</div>
{{/if}}
