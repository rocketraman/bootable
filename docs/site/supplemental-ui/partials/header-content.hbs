<header class="header">
  <nav class="navbar">
    <a class="brand" href="{{{relativize (version-path 'index.html')}}}">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"><rect width="24" height="24" rx="6" fill="currentColor"/><path d="M12 5.5v6.2M8 8.1a5.6 5.6 0 1 0 8 0" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
      </span>
      <span class="brand-name">{{site.title}}</span>
      <span class="brand-docs">Docs</span>
    </a>
    <div class="navbar-sections">
      <a class="section-link{{#if (eq page.module 'ROOT')}} is-current{{/if}}" href="{{{relativize (version-path 'index.html')}}}">Get started</a>
      <a class="section-link{{#if (and page.module (ne page.module 'ROOT') (ne page.module 'examples'))}} is-current{{/if}}" href="{{{relativize (version-path 'configuration/index.html')}}}">Functions</a>
      <a class="section-link{{#if (eq page.module 'examples')}} is-current{{/if}}" href="{{{relativize (version-path 'examples/index.html')}}}">Examples</a>
      <a class="section-link section-link-api" href="{{{relativize (version-path 'api/index.html')}}}">API reference</a>
    </div>
    {{#if env.SITE_SEARCH_PROVIDER}}
    <div class="navbar-search" id="search-field">
      <svg class="navbar-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search-input" type="text" placeholder="Search the docs" aria-label="Search the docs" autocomplete="off">
      <kbd class="navbar-search-key" title="Press / to search">/</kbd>
    </div>
    {{/if}}
    <div class="navbar-tools">
      {{#if page.versions.[1]}}
      {{!-- the docs' versions: each option's data-href is that version of this page, or its start page where this page
           isn't in it; bootable.js goes there --}}
      <label class="di-switch version-switch" title="The version of Bootable the docs describe: next is the work in progress, not yet released">
        <span class="di-switch-label">Version</span>
        <select id="version-switch">
          {{#each page.versions}}
          <option data-href="{{{relativize ./url}}}"{{#if (eq ./version @root.page.version)}} selected{{/if}}>{{./displayVersion}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
      <label class="di-switch" title="The wiring style the code is shown in">
        <span class="di-switch-label">Wiring</span>
        <select id="di-switch">
          <option>Vanilla</option>
          <option>Kodein</option>
          <option>Metro</option>
          <option>Inara</option>
        </select>
      </label>
      <button class="icon-button theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a class="icon-button" href="https://github.com/rocketraman/bootable" aria-label="Bootable on GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
  </nav>
</header>
