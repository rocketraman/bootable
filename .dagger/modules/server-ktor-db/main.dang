"""
Builds the server-ktor-db example's Jib image with its JVM AOT cache, as a CI pipeline.

Gradle's Jib build makes the image, as a tarball, without a container runtime, and the module imports it, trains the
cache in a container of it, and adds the cache to that same container, so the JDK build and the jars' sizes and
modification times, which the JVM checks before it uses the cache, are the training's. The image is the one the Jib
example builds; see the Faster Start section of `README.adoc`.
"""
type ServerKtorDb {
  """
  The Bootable checkout, minus build outputs and local caches.
  """
  pub source: Directory!

  let requests: String!
  let rounds: Int!

  new(
    ws: Workspace!,
    """
    The training run's requests, one per line: `METHOD PATH`, or `METHOD PATH BODY`, sent to the app's port.
    They cover the request path, so the first requests are fast too, not just the start.
    """
    requests: String! = """
      PUT /entries/trained by the AOT training run
      GET /entries/trained
      GET /entries
      GET /
      GET /metrics
      GET /health/ready
      DELETE /entries/trained
      """,
    """
    How many times the training run sends the requests.
    """
    rounds: Int! = 20,
  ) {
    self.source = ws.directory("/", exclude: [
      "**/build",
      "**/.gradle",
      "**/.kotlin",
      "**/node_modules",
      ".git",
      ".idea",
      ".claude",
      ".dagger",
    ])
    self.requests = requests
    self.rounds = rounds
    self
  }

  # ---------------------------------------------------------------------------------------------------------------
  # Build
  # ---------------------------------------------------------------------------------------------------------------

  """
  The build environment with the source checked out, before any Gradle task has run: JDK 25, as `.mise.toml` and
  the build's Java toolchain ask for.
  """
  pub env: Container! {
    container
      .from("eclipse-temurin:25-jdk")
      .withEnvVariable("GRADLE_USER_HOME", "/cache/gradle")
      .withMountedCache("/cache/gradle", cacheVolume("bootable-gradle-user-home"))
      # Jib's cache of the base image's layers
      .withMountedCache("/root/.cache/google-cloud-tools-java", cacheVolume("bootable-jib-cache"))
      .withDirectory("/work/bootable", source)
      .withWorkdir("/work/bootable")
  }

  """
  The Jib image, without an AOT cache, as a tarball, from Gradle's `jibBuildTar`, which needs no container runtime.
  The build cache, in the Gradle user home's cache volume, reuses the task outputs of earlier builds.
  """
  pub jibImage: File! {
    env
      .withExec(["./gradlew", "--no-daemon", "--console=plain", "--build-cache", ":examples:server-ktor-db:jib:jibBuildTar"])
      .file("examples/server-ktor-db/jib/build/jib-image.tar")
  }

  # ---------------------------------------------------------------------------------------------------------------
  # Image
  # ---------------------------------------------------------------------------------------------------------------

  """
  The Jib image, imported, without an AOT cache. Its entrypoint already has `-XX:AOTCache`, for the cache that
  `image` adds.
  """
  pub runtime: Container! {
    container.import(jibImage).withExposedPort(8001)
  }

  """
  Starts the app with the JVM flags `javaFlags`, waits for "=> Running", sends the training requests, and stops it
  with SIGTERM, so the app shuts down as it would in production, and the JVM writes the AOT cache, if asked to, as it
  exits. The app runs as the image's entrypoint does, but for its flags: the JVM takes only one of `-XX:AOTCache` and
  `-XX:AOTCacheOutput`.

  Dagger sets `OTEL_*` variables in every container, for its own tracing, and forwards what they collect to Dagger
  Cloud when the CLI is logged in to it. The script unsets them, so the app exports no telemetry there, then sets an
  OTLP endpoint of its own, as in production, where the app exports its telemetry: the SDK then builds its OTLP
  exporters, whose classes the cache would otherwise leave out. Nothing listens on it, the container's own localhost,
  so the app exports nothing, and logs a failed export as it stops.

  The JRE image has no curl, so the requests go through bash's `/dev/tcp`.
  The script has no brace expansions of shell variables, which Dang would read as its own interpolations.
  """
  let startAndStop(ctr: Container!, javaFlags: String!, requests: String!, rounds: Int!): Container! {
    ctr
      .withEnvVariable("JAVA_FLAGS", javaFlags)
      .withEnvVariable("TRAINING_REQUESTS", requests)
      .withEnvVariable("TRAINING_ROUNDS", `${rounds}`)
      .withNewFile("/run/start-and-stop.sh", """
        set -euo pipefail
        for var in $(compgen -e | grep -E '^(OTEL_|TRACEPARENT$|TRACESTATE$)' || true); do unset "$var"; done
        export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
        log=/run/app.log
        # JAVA_FLAGS unquoted: one argument per flag
        java $JAVA_FLAGS -cp @/app/jib-classpath-file AppKt > "$log" 2>&1 &
        pid=$!

        for _ in $(seq 1200); do
          grep -q '=> Running (' "$log" && break
          if ! kill -0 "$pid" 2>/dev/null; then echo "the app exited before it was ready"; cat "$log"; exit 1; fi
          sleep 0.1
        done
        grep -q '=> Running (' "$log" || { echo "the app wasn't ready within 2 minutes"; cat "$log"; exit 1; }

        request() {
          local method=$1 path=$2 body=$3 length
          length=$(printf %s "$body" | wc -c)
          exec 3<>/dev/tcp/127.0.0.1/8001
          printf '%s %s HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\nContent-Length: %d\\r\\n\\r\\n%s' "$method" "$path" "$length" "$body" >&3
          local status
          read -r _ status _ <&3
          cat <&3 > /dev/null
          exec 3<&-
          if [ "$status" -ge 400 ]; then echo "$method $path returned $status"; kill -KILL "$pid"; exit 1; fi
        }

        for _ in $(seq "$TRAINING_ROUNDS"); do
          # read puts the rest of the line, the body, in its last variable
          while read -r method path body; do
            [ -n "$method" ] || continue
            request "$method" "$path" "$body"
          done <<< "$TRAINING_REQUESTS"
        done

        kill -TERM "$pid"
        wait "$pid" || true
        cat "$log"
        """)
      .withExec(["bash", "/run/start-and-stop.sh"])
  }

  """
  The AOT cache, from a training run of the runtime: the app started with `-XX:AOTCacheOutput`, the training
  requests, and SIGTERM.
  """
  pub aotCache: File! {
    startAndStop(runtime, "-XX:AOTCacheOutput=/run/server-ktor-db.aot", requests, rounds).file("/run/server-ktor-db.aot")
  }

  """
  The image: the runtime, with the AOT cache at `/app/aot/server-ktor-db.aot`, where its entrypoint looks for it.
  `image export --path=server-ktor-db.tar` writes it to disk; nothing here publishes it.
  """
  pub image: Container! {
    runtime.withFile("/app/aot/server-ktor-db.aot", aotCache)
  }

  """
  Starts the image once, and fails unless the JVM loaded at least `minPercent` of the classes of its start from the
  AOT cache: a JDK build or class path that doesn't match the training's loads them all anew.
  Its `stdout` says how many it loaded from the cache.
  """
  pub verify(
    minPercent: Int! = 90,
  ): Container! {
    startAndStop(image, "-XX:AOTCache=/app/aot/server-ktor-db.aot -Xlog:class+load=info:file=/run/class-load.log", "", 0)
      .withEnvVariable("MIN_PERCENT", `${minPercent}`)
      .withExec(["sh", "-c", """
        shared=$(grep -c 'source: shared objects file' /run/class-load.log)
        total=$(grep -c 'class,load' /run/class-load.log)
        echo "$shared of $total classes loaded from the AOT cache"
        [ $((shared * 100)) -ge $((total * MIN_PERCENT)) ] || { echo "below $MIN_PERCENT%"; exit 1; }
        """])
  }

  """
  The pull request check: builds the image, and verifies that it uses its AOT cache. It publishes nothing.
  """
  pub check: Void @check {
    verify.sync
    null
  }

  # ---------------------------------------------------------------------------------------------------------------
  # Local run
  # ---------------------------------------------------------------------------------------------------------------

  """
  The image, on port 8001. `dagger start` runs it and tunnels the port to `localhost`.
  """
  @up
  pub dev: Service! {
    serve(image, 8001)
  }

  """
  `dev`, on port 8002, exporting its traces and metrics over OTLP to Grafana's `otel-lgtm` stack, which runs alongside
  it. `dagger start server-ktor-db/lgtm` starts both.
  """
  pub lgtm: Lgtm! {
    Lgtm(parent: self)
  }

  """
  Runs `ctr` as the image's entrypoint does, as a service on `port`.

  The script unsets Dagger's own `OTEL_*` variables, as `startAndStop` does, then exports `OTLP_ENDPOINT`, if set,
  as `OTEL_EXPORTER_OTLP_ENDPOINT`: a variable of the app's own, without the `OTEL_` prefix, so the unset leaves it.
  """
  let serve(ctr: Container!, port: Int!): Service! {
    ctr
      .withEnvVariable("SERVER_HOSTPORT", `:${port}`)
      # the runtime exposes 8001, its default
      .withoutExposedPort(8001)
      .withExposedPort(port)
      .asService(args: ["bash", "-c", """
        for var in $(compgen -e | grep -E '^(OTEL_|TRACEPARENT$|TRACESTATE$)' || true); do unset "$var"; done
        [ -z "$OTLP_ENDPOINT" ] || export OTEL_EXPORTER_OTLP_ENDPOINT="$OTLP_ENDPOINT"
        exec java -XX:AOTCache=/app/aot/server-ktor-db.aot -cp @/app/jib-classpath-file AppKt
        """])
  }
}

"""
The image, with Grafana's `otel-lgtm` stack: an OpenTelemetry collector, Prometheus, Tempo, Loki and Grafana, in one
container. `dagger start server-ktor-db/lgtm` starts both, and tunnels the app's port, 8002, Grafana's, 3000, and the
collector's, 4318, to `localhost`.
The app is on 8002, not `dev`'s 8001, so a plain `dagger start`, which starts every service, can tunnel both.
"""
type Lgtm {
  let parent: ServerKtorDb!

  new(parent: ServerKtorDb!) {
    self.parent = parent
    self
  }

  """
  Grafana's `otel-lgtm` stack: Grafana on port 3000, and its collector's OTLP receiver on 4318, over HTTP.
  The app reaches it by its binding's hostname, `lgtm`.
  """
  @up
  pub stack: Service! {
    container
      .from("docker.io/grafana/otel-lgtm:0.41.0")
      .withExposedPort(3000)
      .withExposedPort(4318)
      .asService
  }

  """
  The image, on port 8002, exporting its traces and metrics to `stack`, its metrics every 5 seconds, rather than
  every minute, so they show in Grafana soon after the requests.
  """
  @up
  pub dev: Service! {
    parent.serve(
      parent.image
        .withServiceBinding("lgtm", stack)
        .withEnvVariable("OTLP_ENDPOINT", "http://lgtm:4318")
        .withEnvVariable("TELEMETRY_SDK_METRICS_INTERVAL", "5s"),
      8002,
    )
  }
}
